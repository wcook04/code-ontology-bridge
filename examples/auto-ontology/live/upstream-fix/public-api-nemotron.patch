diff --git a/auto_ontology/utils/llm_invoke.py b/auto_ontology/utils/llm_invoke.py
index bc1694f..a5c13fd 100644
--- a/auto_ontology/utils/llm_invoke.py
+++ b/auto_ontology/utils/llm_invoke.py
@@ -211,6 +211,30 @@ _NON_REASONING_MODEL_NAME = resolve("NON_REASONING", "MODEL")
 _NON_REASONING_API_KEY = resolve("NON_REASONING", "API_KEY")
 
 
+def _env_flag(name: str, default: bool) -> bool:
+    value = os.environ.get(name)
+    return (
+        default
+        if value is None
+        else value.strip().lower() in {"1", "true", "yes", "on"}
+    )
+
+
+def _nemotron_thinking_kwargs(model: str, thinking: bool) -> dict:
+    """Request fields that switch Nemotron reasoning on or off.
+
+    Nemotron 3.5 models reason before answering by default. Under
+    ``response_format`` a long reasoning trace can outlast
+    ``LLM_INVOKE_TIMEOUT_S``; ChatNVIDIA then falls back to ``guided_json``,
+    which the hosted API rejects ("unknown field `guided_json`"). Turning
+    reasoning off returns the structured answer directly. Other models get no
+    extra fields.
+    """
+    if not model.startswith("nvidia/nemotron"):
+        return {}
+    return {"chat_template_kwargs": {"enable_thinking": thinking}}
+
+
 def _build_client(
     *,
     model: str,
@@ -218,6 +242,7 @@ def _build_client(
     base_url: str,
     temperature: float,
     max_tokens: int,
+    thinking: bool = True,
 ) -> BaseChatModel:
     """Build a chat client for the given model/endpoint.
 
@@ -249,6 +274,7 @@ def _build_client(
         base_url=base_url,
         temperature=temperature,
         max_tokens=max_tokens,
+        model_kwargs=_nemotron_thinking_kwargs(model, thinking),
     )
     client._client.get_session_fn = lambda: _TimeoutSession(LLM_INVOKE_TIMEOUT_S)
     return client
@@ -276,6 +302,7 @@ def get_llm_client(
         base_url=_BASE_URL,
         temperature=temperature,
         max_tokens=max_tokens,
+        thinking=_env_flag("REASONING_ENABLE_THINKING", False),
     )
 
 
@@ -305,6 +332,7 @@ def get_non_reasoning_llm_client(
         base_url=_NON_REASONING_BASE_URL,
         temperature=temperature,
         max_tokens=max_tokens,
+        thinking=_env_flag("NON_REASONING_ENABLE_THINKING", False),
     )
     _remember_non_reasoning(client)
     return client
