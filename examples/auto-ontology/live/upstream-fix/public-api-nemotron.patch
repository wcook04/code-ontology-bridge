diff --git a/auto_ontology/utils/tests/test_llm_invoke.py b/auto_ontology/utils/tests/test_llm_invoke.py
index 40be8f6..1519783 100644
--- a/auto_ontology/utils/tests/test_llm_invoke.py
+++ b/auto_ontology/utils/tests/test_llm_invoke.py
@@ -495,3 +495,42 @@ def test_missing_reasoning_client_keeps_the_original_failure(monkeypatch: Any) -
     monkeypatch.setattr(llm_invoke, "get_llm_client", unavailable)
 
     assert llm_invoke.invoke_with_structured_output(primary, [], _Schema) is None
+
+
+def test_nemotron_thinking_kwargs_only_for_nemotron():
+    assert llm_invoke._nemotron_thinking_kwargs(
+        "nvidia/nemotron-3.5-lightning-30b-a3b", False
+    ) == {"chat_template_kwargs": {"enable_thinking": False}}
+    assert llm_invoke._nemotron_thinking_kwargs(
+        "nvidia/nemotron-3.5-lightning-30b-a3b", True
+    ) == {"chat_template_kwargs": {"enable_thinking": True}}
+    assert (
+        llm_invoke._nemotron_thinking_kwargs(
+            "aws/anthropic/bedrock-claude-opus-4-8", False
+        )
+        == {}
+    )
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [(None, False), ("true", True), ("1", True), ("off", False), ("FALSE", False)],
+)
+def test_env_flag(monkeypatch, value, expected):
+    monkeypatch.delenv("X_ENABLE_THINKING", raising=False)
+    if value is not None:
+        monkeypatch.setenv("X_ENABLE_THINKING", value)
+    assert llm_invoke._env_flag("X_ENABLE_THINKING", False) is expected
+
+
+def test_chat_nvidia_client_sends_thinking_switch(monkeypatch):
+    monkeypatch.delenv("NON_REASONING_ENABLE_THINKING", raising=False)
+    client = llm_invoke._build_client(
+        model="nvidia/nemotron-3.5-lightning-30b-a3b",
+        api_key="nvapi-test",
+        base_url="https://integrate.api.nvidia.com/v1",
+        temperature=0.0,
+        max_tokens=16,
+        thinking=False,
+    )
+    assert client.model_kwargs == {"chat_template_kwargs": {"enable_thinking": False}}
