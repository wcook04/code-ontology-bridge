WITH edges AS (SELECT DISTINCT caller_file.package AS caller_pkg, callee_file.package AS callee_pkg FROM auto_ontology_code.code.calls AS c JOIN auto_ontology_code.code.symbols AS caller_symbol ON c.caller_symbol_id = caller_symbol.symbol_id JOIN auto_ontology_code.code.files AS caller_file ON caller_symbol.file_id = caller_file.file_id JOIN auto_ontology_code.code.symbols AS callee_symbol ON c.callee_symbol_id = callee_symbol.symbol_id JOIN auto_ontology_code.code.files AS callee_file ON callee_symbol.file_id = callee_file.file_id WHERE c.resolution IN ('same_file', 'imported', 'method_on_self') AND c.callee_symbol_id IS NOT NULL AND caller_file.is_test = FALSE AND callee_file.is_test = FALSE AND caller_file.package <> '' AND callee_file.package <> '' AND caller_file.package <> callee_file.package) SELECT e1.caller_pkg AS package_a, e1.callee_pkg AS package_b FROM edges AS e1 JOIN edges AS e2 ON e1.caller_pkg = e2.callee_pkg AND e1.callee_pkg = e2.caller_pkg WHERE e1.caller_pkg < e1.callee_pkg ORDER BY package_a, package_b
