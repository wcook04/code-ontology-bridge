WITH call_edges AS (SELECT DISTINCT caller_file.package AS caller_package, callee_file.package AS callee_package FROM auto_ontology_code.code.calls AS c JOIN auto_ontology_code.code.symbols AS caller_symbol ON c.caller_symbol_id = caller_symbol.symbol_id JOIN auto_ontology_code.code.files AS caller_file ON caller_symbol.file_id = caller_file.file_id JOIN auto_ontology_code.code.symbols AS callee_symbol ON c.callee_symbol_id = callee_symbol.symbol_id JOIN auto_ontology_code.code.files AS callee_file ON callee_symbol.file_id = callee_file.file_id WHERE c.resolution IN ('same_file', 'imported', 'method_on_self') AND caller_file.is_test = FALSE AND callee_file.is_test = FALSE AND caller_file.package <> '' AND callee_file.package <> '' AND caller_file.package <> callee_file.package) SELECT DISTINCT e1.caller_package AS package_a, e1.callee_package AS package_b FROM call_edges AS e1 JOIN call_edges AS e2 ON e1.caller_package = e2.callee_package AND e1.callee_package = e2.caller_package WHERE e1.caller_package < e1.callee_package ORDER BY package_a, package_b;
