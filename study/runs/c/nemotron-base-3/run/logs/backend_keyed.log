SELECT callee_sym.symbol_id, COUNT(DISTINCT caller_sym.symbol_id) AS caller_count
FROM auto_ontology_code.code.calls AS c
JOIN auto_ontology_code.code.symbols AS callee_sym ON c.callee_symbol_id = callee_sym.symbol_id
JOIN auto_ontology_code.code.symbols AS caller_sym ON c.caller_symbol_id = caller_sym.symbol_id
WHERE c.call_kind = 'direct'
  AND callee_sym.kind = 'function'
  AND callee_sym.file_id LIKE 'auto_ontology/dal/%'
  AND callee_sym.file_id != 'auto_ontology/dal/session.py'
  AND caller_sym.kind IN ('function','method')
  AND caller_sym.file_id NOT LIKE 'tests/%'
  AND caller_sym.file_id NOT LIKE '%/tests/%'
GROUP BY callee_sym.symbol_id
ORDER BY caller_count DESC, callee_sym.symbol_id ASC
LIMIT 5;
