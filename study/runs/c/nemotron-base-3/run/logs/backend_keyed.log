WITH connector_classes AS (
    SELECT symbol_id AS class_symbol_id,
           name AS class_name,
           line_start,
           line_end
    FROM auto_ontology_code.code.symbols
    WHERE kind = 'class'
      AND file_id LIKE 'auto_ontology/connectors/%'
      AND file_id NOT LIKE '%/tests/%'
),
connector_methods AS (
    SELECT s.name AS method_name,
           c.class_symbol_id
    FROM auto_ontology_code.code.symbols s
    JOIN connector_classes c
      ON s.qualname LIKE c.class_name || '.%'
     AND s.kind = 'method'
     AND s.is_public = true
     AND s.line_start >= c.line_start
     AND s.line_end <= c.line_end
     AND s.qualname NOT LIKE 'SQLDatabase.%'
)
SELECT c.class_symbol_id,
       s.method_name
FROM connector_methods s
JOIN connector_classes c
  ON c.class_symbol_id = s.class_symbol_id
ORDER BY c.class_symbol_id,
         s.method_name;
