WITH kinds AS (SELECT 'class' AS kind UNION ALL SELECT 'function' UNION ALL SELECT 'method'), counts AS (SELECT s.kind AS kind, COUNT(*) AS public_count FROM auto_ontology_code.code.symbols AS s INNER JOIN auto_ontology_code.code.files AS f ON s.file_id = f.file_id WHERE s.is_public = TRUE AND f.is_test = FALSE AND f.file_id LIKE 'auto_ontology/retrieval/kumo/%' AND s.kind IN ('class', 'function', 'method') AND ((s.kind IN ('class', 'function') AND s.qualname = s.name) OR s.kind = 'method') GROUP BY s.kind) SELECT k.kind AS kind, COALESCE(c.public_count, 0) AS public_count FROM kinds AS k LEFT JOIN counts AS c ON k.kind = c.kind ORDER BY CASE k.kind WHEN 'class' THEN 1 WHEN 'function' THEN 2 WHEN 'method' THEN 3 END
