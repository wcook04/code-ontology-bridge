WITH RECURSIVE api AS (SELECT symbol_id FROM auto_ontology_code.code.symbols WHERE kind = 'class' AND name = 'ApiModel' AND file_id = 'auto_ontology/server/models.py'), bases AS (SELECT cb.class_symbol_id, cb.base_symbol_id, regexp_extract(split_part(cb.base_name, '[', 1), '[A-Za-z0-9_]+$') AS base_tail FROM auto_ontology_code.code.class_bases AS cb), edges AS (SELECT DISTINCT child, parent FROM (SELECT b.class_symbol_id AS child, b.base_symbol_id AS parent FROM bases AS b JOIN auto_ontology_code.code.symbols AS s ON s.symbol_id = b.base_symbol_id AND s.kind = 'class' WHERE b.base_symbol_id IS NOT NULL UNION ALL SELECT b.class_symbol_id AS child, s.symbol_id AS parent FROM bases AS b JOIN auto_ontology_code.code.symbols AS s ON s.name = b.base_tail AND s.kind = 'class' WHERE b.base_symbol_id IS NULL) AS e), paths AS (SELECT e.child AS class_symbol_id, 1 AS depth FROM edges AS e JOIN api ON e.parent = api.symbol_id UNION ALL SELECT e.child AS class_symbol_id, p.depth + 1 AS depth FROM edges AS e JOIN paths AS p ON e.parent = p.class_symbol_id WHERE p.depth < 25), direct AS (SELECT DISTINCT b.class_symbol_id FROM bases AS b WHERE b.base_symbol_id IN (SELECT symbol_id FROM api) OR b.base_tail IN ('ApiModel', '_Payload')) SELECT p.class_symbol_id AS class_symbol_id, MIN(p.depth) AS depth FROM paths AS p JOIN auto_ontology_code.code.symbols AS sy ON sy.symbol_id = p.class_symbol_id AND sy.kind = 'class' WHERE p.class_symbol_id NOT IN (SELECT class_symbol_id FROM direct) GROUP BY p.class_symbol_id ORDER BY depth, p.class_symbol_id
