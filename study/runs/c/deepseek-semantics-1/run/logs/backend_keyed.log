2026-11-05 11:04:51,435 INFO auto_ontology.retrieval.text_to_sql.chat_sql: [auto_ontology_code] Executing chat SQL:
SELECT DISTINCT cb.class_symbol_id AS class_symbol_id
FROM auto_ontology_code.code.class_bases AS cb
JOIN auto_ontology_code.code.symbol_profile AS sp
  ON sp.symbol_id = cb.class_symbol_id
 AND sp.is_class = TRUE
 AND sp.in_test_file = FALSE
WHERE cb.base_symbol_id LIKE 'auto_ontology/retrieval/text_to_sql/base.py::BaseAgent%'
AND EXISTS (
  SELECT 1
  FROM auto_ontology_code.code.call_edges AS ce
  WHERE ce.callee_symbol_id = cb.class_symbol_id
    AND ce.calls_directly = TRUE
    AND ce.caller_in_test_file = FALSE
    AND ce.callee_kind = 'class'
)
AND NOT EXISTS (
  SELECT 1
  FROM auto_ontology_code.code.call_edges AS ce2
  WHERE ce2.callee_symbol_id = cb.class_symbol_id
    AND ce2.calls_directly = TRUE
    AND ce2.caller_in_test_file = TRUE
    AND ce2.callee_kind = 'class'
)
ORDER BY cb.class_symbol_id;
