2026-11-05 11:08:59,216 INFO auto_ontology.retrieval.text_to_sql.chat_sql: [auto_ontology_code] Executing chat SQL:
SELECT sp.symbol_id AS symbol_id, COUNT(DISTINCT ce.caller_symbol_id) AS caller_count
FROM code.symbol_profile AS sp
JOIN code.call_edges AS ce ON ce.callee_symbol_id = sp.symbol_id
WHERE sp.is_function = TRUE
  AND sp.is_method = FALSE
  AND sp.is_class = FALSE
  AND sp.enclosing_class_symbol_id IS NULL
  AND sp.in_test_file = FALSE
  AND sp.file_id LIKE 'auto_ontology/dal/%'
  AND sp.file_id <> 'auto_ontology/dal/session.py'
  AND ce.calls_directly = TRUE
  AND ce.caller_in_test_file = FALSE
  AND ce.caller_file_id NOT LIKE 'auto_ontology/dal/%'
  AND ce.caller_kind IN ('function', 'method')
GROUP BY sp.symbol_id
ORDER BY caller_count DESC, sp.symbol_id ASC
LIMIT 5;
