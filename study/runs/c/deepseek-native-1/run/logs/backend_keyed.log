2026-11-05 14:51:12,944 INFO auto_ontology.retrieval.text_to_sql.chat_sql: [auto_ontology_code] Executing chat SQL:
SELECT DISTINCT
    cb.class_symbol_id AS class_symbol_id,
    m.name AS method_name
FROM auto_ontology_code.code.class_bases AS cb
JOIN auto_ontology_code.code.symbols AS c
    ON cb.class_symbol_id = c.symbol_id
JOIN auto_ontology_code.code.symbols AS m
    ON m.file_id = c.file_id
   AND m.symbol_id = c.symbol_id || '.' || m.name
   AND m.kind = 'method'
   AND m.is_public = TRUE
WHERE cb.base_name = 'SQLDatabase'
  AND c.kind = 'class'
  AND c.file_id NOT LIKE 'tests/%'
  AND c.file_id NOT LIKE '%/tests/%'
  AND NOT EXISTS (
      SELECT 1
      FROM auto_ontology_code.code.symbols AS b
      JOIN auto_ontology_code.code.symbols AS bm
        ON bm.file_id = b.file_id
       AND bm.symbol_id = b.symbol_id || '.' || bm.name
       AND bm.kind = 'method'
      WHERE b.file_id = 'auto_ontology/connectors/base.py'
        AND b.name = 'SQLDatabase'
        AND b.kind = 'class'
        AND bm.name = m.name
  )
ORDER BY cb.class_symbol_id, m.name
