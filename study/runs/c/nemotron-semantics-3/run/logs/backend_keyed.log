WITH target_symbol AS (
    SELECT symbol_id
    FROM auto_ontology_code.code.symbol_profile
    WHERE name = 'invoke_with_structured_output'
),
direct_callers AS (
    SELECT DISTINCT ce.caller_symbol_id
    FROM auto_ontology_code.code.call_edges ce
    WHERE ce.callee_symbol_id = (SELECT symbol_id FROM target_symbol)
    AND ce.calls_directly = True
),
two_hop_callers AS (
    SELECT DISTINCT ce.caller_symbol_id
    FROM auto_ontology_code.code.call_edges ce
    WHERE ce.calls_directly = True
    AND ce.callee_symbol_id IN (SELECT caller_symbol_id FROM direct_callers)
),
non_test_two_hop AS (
    SELECT t.symbol_id
    FROM two_hop_callers t
    JOIN auto_ontology_code.code.symbol_profile sp
        ON t.symbol_id = sp.symbol_id
    WHERE sp.in_test_file = False
)
SELECT symbol_id
FROM non_test_two_hop
WHERE symbol_id NOT IN (SELECT caller_symbol_id FROM direct_callers)
