2026-11-05 14:38:39,979 INFO auto_ontology.retrieval.text_to_sql.chat_sql: [auto_ontology_code] Executing chat SQL:
WITH candidate_functions AS (
    SELECT symbol_id
    FROM auto_ontology_code.code.symbol_profile
    WHERE kind = 'function'
      AND is_function = true
      AND is_method = false
      AND is_class = false
      AND in_test_file = false
      AND file_id LIKE 'auto_ontology/dal/%'
      AND file_id != 'auto_ontology/dal/session.py'
),
caller_counts AS (
    SELECT e.callee_symbol_id, COUNT(DISTINCT e.caller_symbol_id) AS caller_count
    FROM auto_ontology_code.code.call_edges e
    JOIN candidate_functions c ON e.callee_symbol_id = c.symbol_id
    WHERE e.caller_in_test_file = false
      AND e.caller_file_id NOT LIKE 'auto_ontology/dal/%'
      AND e.caller_kind IN ('function', 'method')
      AND e.calls_directly = true
    GROUP BY e.callee_symbol_id
)
SELECT callee_symbol_id AS symbol_id, caller_count
FROM caller_counts
ORDER BY caller_count DESC, symbol_id ASC
LIMIT 5;
