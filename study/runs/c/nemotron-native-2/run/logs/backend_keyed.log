2026-11-05 16:54:36,396 INFO auto_ontology.retrieval.text_to_sql.chat_sql: [auto_ontology_code] Executing chat SQL:
WITH baseagent_subclasses AS (
    SELECT s.symbol_id AS class_symbol_id
    FROM code.class_bases cb
    JOIN code.symbols s ON cb.class_symbol_id = s.symbol_id
    WHERE cb.base_name = 'BaseAgent'
),
direct_calls AS (
    SELECT bas.class_symbol_id,
           c.callee_symbol_id,
           f.is_test AS caller_is_test_file
    FROM baseagent_subclasses bas
    JOIN code.calls c ON c.callee_symbol_id = bas.class_symbol_id
    JOIN code.symbols caller_sym ON c.caller_symbol_id = caller_sym.symbol_id
    JOIN code.files f ON caller_sym.file_id = f.file_id
    WHERE c.call_kind = 'direct'
),
class_summary AS (
    SELECT class_symbol_id,
           COUNT(CASE WHEN NOT caller_is_test_file THEN 1 END) AS non_test_call_count,
           COUNT(CASE WHEN caller_is_test_file THEN 1 END) AS test_call_count
    FROM direct_calls
    GROUP BY class_symbol_id
)
SELECT class_symbol_id
FROM class_summary
WHERE non_test_call_count > 0 AND test_call_count = 0
ORDER BY class_symbol_id
