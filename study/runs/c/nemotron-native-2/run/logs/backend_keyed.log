    WHERE cb.base_name = 'BaseAgent'
),
direct_calls AS (
    SELECT c.callee_symbol_id,
           f.is_test AS caller_is_test_file
    FROM code.calls c
    JOIN baseagent_subclasses bas ON c.callee_symbol_id = bas.class_symbol_id
