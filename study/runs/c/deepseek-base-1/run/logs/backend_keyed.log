SELECT DISTINCT cls.symbol_id AS class_symbol_id, m.name AS method_name
FROM symbols AS cls
JOIN class_bases AS cb
  ON cb.class_symbol_id = cls.symbol_id
JOIN symbols AS sqldb
  ON (cb.base_symbol_id = sqldb.symbol_id
      OR (cb.base_symbol_id IS NULL AND cb.base_name IN ('SQLDatabase', 'base.SQLDatabase')))
 AND sqldb.kind = 'class'
 AND sqldb.name = 'SQLDatabase'
 AND sqldb.file_id = 'auto_ontology/connectors/base.py'
JOIN files AS f
  ON f.file_id = cls.file_id
JOIN symbols AS m
  ON m.file_id = cls.file_id
 AND m.kind = 'method'
 AND m.qualname = cls.qualname || '.' || m.name
 AND m.line_start > cls.line_start
 AND m.line_end <= cls.line_end
 AND LEFT(m.name, 1) <> '_'
WHERE cls.kind = 'class'
  AND f.is_test = FALSE
  AND NOT EXISTS (
      SELECT 1
      FROM symbols AS sm
      WHERE sm.file_id = sqldb.file_id
        AND sm.kind = 'method'
        AND sm.qualname = sqldb.qualname || '.' || sm.name
        AND sm.name = m.name
        AND sm.line_start > sqldb.line_start
        AND sm.line_end <= sqldb.line_end
        AND LEFT(sm.name, 1) <> '_'
  )
ORDER BY class_symbol_id, method_name
