      "sql": "WITH echo_syms AS (\n  SELECT symbol_id FROM code.symbols\n  WHERE file_id = 'src/click/utils.py' AND name = 'echo'\n),\ndirect AS (\n  SELECT c.caller_symbol_id AS sid, c.line\n  FROM code.calls c\n  JOIN echo_syms e ON c.callee_symbol_id = e.symbol_id\n  WHERE c.call_kind = 'direct'\n),\ncallers AS (\n  SELECT s.symbol_id, s.file_id, s.qualname, s.line_start, s.line_end\n  FROM code.symbols s\n  WHERE s.symbol_id IN (SELECT sid FROM direct)\n),\nnested AS (\n  SELECT s.symbol_id AS helper_id, s.qualname AS helper_qualname, s.line_start, s.line_end,\n         c.caller_symbol_id AS enclosing_id\n  FROM code.symbols s\n  JOIN code.calls c ON c.callee_symbol_id = s.symbol_id\n  WHERE s.kind IN ('function','method')\n    AND s.qualname LIKE '%<locals>%'\n    AND c.call_kind IN ('direct','callback')\n),\nvia_helper AS (\n  SELECT n.enclosing_id AS sid, d.line\n  FROM nested n\n  JOIN direct d ON d.sid = n.helper_id\n)\nSELECT sid AS caller_symbol_id, COUNT(*)::INTEGER AS call_sites\nFROM (\n  SELECT sid, line FROM direct\n  UNION ALL\n  SELECT sid, line FROM via_helper\n) u\nGROUP BY sid\nORDER BY call_sites DESC, caller_symbol_id",
