  "sql": "SELECT DISTINCT s.symbol_id AS class_symbol_id, m.name AS method_name FROM code.class_bases cb JOIN code.symbols s ON s.symbol_id = cb.class_symbol_id JOIN code.symbols base ON base.symbol_id = cb.base_symbol_id JOIN code.symbols m ON m.file_id = s.file_id AND m.qualname = s.qualname || '.' || m.name AND m.kind = 'method' WHERE base.qualname = 'SQLDatabase' AND base.name = 'SQLDatabase' AND base.file_id = 'auto_ontology/connectors/base.py' AND s.kind = 'class' AND s.file_id NOT LIKE '%/tests/%' AND s.file_id NOT LIKE 'tests/%' AND m.name NOT LIKE '\\_%' ESCAPE '\\' AND NOT EXISTS (SELECT 1 FROM code.symbols bm WHERE bm.symbol_id = base.symbol_id AND bm.kind = 'class' AND bm.name = m.name) ORDER BY class_symbol_id, method_name",
