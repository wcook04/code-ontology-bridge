      "sql": "WITH RECURSIVE inheritance_tree AS (\n  -- Base case: classes that directly subclass ApiModel\n  SELECT s.symbol_id AS class_symbol_id, 1 AS depth\n  FROM code.symbols s\n  JOIN code.class_bases cb ON s.symbol_id = cb.class_symbol_id\n  WHERE cb.base_name = 'ApiModel'\n  UNION ALL\n  -- Recursive step: find classes that subclass the classes found so far\n  SELECT s.symbol_id, it.depth + 1\n  FROM code.symbols s\n  JOIN code.class_bases cb ON s.symbol_id = cb.class_symbol_id\n  JOIN inheritance_tree it ON cb.base_name = it.class_symbol_id\n  WHERE it.depth < 5\n)\nSELECT class_symbol_id, MIN(depth) AS depth\nFROM inheritance_tree\nGROUP BY class_symbol_id\nORDER BY depth ASC, class_symbol_id ASC;",
