      "sql": "WITH RECURSIVE inheritance_tree AS (\n  -- Base case: classes that directly subclass ApiModel\n  SELECT s.symbol_id AS class_symbol_id, 2 AS depth\n  FROM code.symbols s\n  JOIN code.class_bases cb ON s.symbol_id = cb.class_symbol_id\n  WHERE cb.base_name = 'ApiModel'\n\n  UNION ALL\n\n  -- Recursive case: find classes that subclass intermediate classes\n  SELECT s.symbol_id, it.depth + 1\n  FROM inheritance_tree it\n  JOIN code.class_bases cb ON cb.base_symbol_id = it.class_symbol_id\n  JOIN code.symbols s ON cb.class_symbol_id = s.symbol_id\n  WHERE cb.base_name != 'ApiModel'  -- exclude ApiModel itself from intermediate\n  AND s.symbol_id NOT IN (SELECT class_symbol_id FROM inheritance_tree)\n)\nSELECT class_symbol_id, depth\nFROM inheritance_tree\nORDER BY depth, class_symbol_id",
